# Render backend and private Supabase schema (secrets stay on the backend)
SPRING_PROFILES_ACTIVE=cloud
JDBC_DATABASE_URL=jdbc:postgresql://your-session-pooler.supabase.com:5432/postgres?sslmode=require
PGUSER=streamguard_backend.your-project-ref
PGPASSWORD=configure-in-render
FRONTEND_ORIGIN=https://streamguard-delta.vercel.app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MEDIA_STORAGE=database
MEDIA_DIR=/tmp/streamguard/media
MEDIA_WORK_DIR=/tmp/streamguard/work
MAX_VIEWERS=6
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Vercel frontend build: public backend URL only
PUBLIC_API_URL=https://streamguard-backend.onrender.com
